# Ignore notebook checkpoints
.ipynb_checkpoints/

# Ignore cache files
__pycache__/
**/__pycache__/

# Revision sub-module: extracted recordings are large and re-derivable
revision/data/
revision/figures/*.png

# Scratch debugging: not part of the DVC pipeline, not reproducible output
analysis/debug/

# Virtual environment
.env/

# Packaging
*.egg-info/
build/
dist/

